# ─────────────────────────────────────────────────────────────
# Client-side (exposed to the browser — only VITE_* variables are)
# ─────────────────────────────────────────────────────────────
# Supabase project URL + anon (public) key. Leave the placeholders
# in place to run the app in local demo mode (no backend required).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─────────────────────────────────────────────────────────────
# Server-side only (Vercel functions in /api — never exposed)
# ─────────────────────────────────────────────────────────────
# Required for AI extraction — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional model overrides
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional — better destination / hotel imagery (Wikipedia is used when unset)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Optional — higher quality brand logos (https://logo.dev, publishable pk_ token)
LOGO_DEV_TOKEN=

# Never put the Supabase service-role key in this app. It is not needed.
